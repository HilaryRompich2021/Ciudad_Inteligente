{
  "index_patterns": ["events-*"] ,
  "template": {
    "mappings": {
      "properties": {
        "event_id":   { "type": "keyword" },
        "event_type": { "type": "keyword" },
        "timestamp":  { "type": "date"    },
        "geo":        { "type": "geo_point" },
        "severity":   { "type": "keyword" },
        "payload":    { "type": "object", "enabled": true }
      }
    }
  }
}
