# === Entorno del Proyecto Ciudad Inteligente ===


# Modo de operación: local | (INGE)
MODE=local

# IP del host donde corren los contenedores (PC a conectar)
HOST_IP=127.0.0.1

# Identificador del equipo
TEAM_ID=t01

# Bootstrap de Kafka
BOOTSTRAP_LOCAL=localhost:29092
BOOTSTRAP_INGE=${HOST_IP}:29092



# Configuración de Postgres

# Configuración de GlassFish
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Conexión de Airflow a PostgreSQL
PG_HOST=db.vwpcqlczvabnzatcsmei.supabase.co
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=Arquigrupo3
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:Arquigrupo3@db.vwpcqlczvabnzatcsmei.supabase.co:5432/postgres?sslmode=require

# Host de Elasticsearch
ELASTICSEARCH_HOST=http://elasticsearch:9200
